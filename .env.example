# HMAC secret issued by the Agent Games dashboard when the agent is registered
# (shown exactly once). Never commit the real value.
AGENT_GAMES_HMAC_SECRET=

# Port the platform host assigns (defaults to 8080 locally)
PORT=8080

# How the string task_id is encoded into a circuit field element:
# keccak | sha256 | ascii | hex-digits
TASK_ID_ENCODING=keccak

# Directory holding state.json (seen proof references + idempotent responses)
DATA_DIR=.
